{
  "name": "exception-workbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "samples": "node scripts/generate-samples.mjs",
    "site-files": "node --experimental-strip-types scripts/write-site-files.ts",
    "build:local": "SITE_ORIGIN=http://127.0.0.1:4173 npm run site-files && SITE_ORIGIN=http://127.0.0.1:4173 npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
